<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<meta name="author" content="NovoTech Machine Tools Inc.">
<style>
{{ css | safe }}
</style>
</head>
<body>

{# ------------------------------------------------------------ shared blocks #}
{% macro header(band) %}
<header class="hdr">
  <img class="hdr-logo" src="{{ novofab_logo }}" alt="NovoTech Machine Tools">
  <div>
    <div class="t1">Sawing machines</div>
    <div class="t2">Metal cutting band saws · NovoTech value line · Catalogue 2026</div>
  </div>
  <div class="hdr-band">{{ band }}</div>
</header>
{% endmacro %}

{% macro footer(n) %}
<footer>
  <div class="incl">
    <div class="lab">{{ included_label }}</div>
    <ul>
      {% for it in included_items %}<li>{{ it }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="company">
    <img src="{{ novotech_logo }}" alt="NovoTech Machine Tools Inc.">
    <div class="txt"><b>NovoTech Machine Tools Inc.</b>{{ company_line | replace("NovoTech Machine Tools Inc. · ", "") }}</div>
    <div class="pn">{{ "%02d" % n }}</div>
  </div>
</footer>
{% endmacro %}

{# ------------------------------------------------------------ 1. cover #}
<section class="page cover" id="p-cover">
  <div class="top">
    <img src="{{ novofab_logo }}" alt="NovoTech Machine Tools">
  </div>
  <div class="tab">Product catalogue 2026</div>
  <div class="titles">
    <div class="eyebrow">NovoTech value line · {{ n_models }} models · {{ n_series }} series</div>
    <h1>Metal cutting<br>band saws</h1>
    <div class="rule"></div>
    <h2>Catalogue 2026</h2>
    <p class="sub">Value line · Sold, installed and supported in Canada by NovoTech Machine Tools</p>
  </div>
  <div class="collage">
    <figure class="c1"><img src="{{ cover_photos[0] }}" alt=""></figure>
    <figure class="c2"><img src="{{ cover_photos[1] }}" alt=""></figure>
    <figure class="c3"><img src="{{ cover_photos[2] }}" alt=""></figure>
    <figure class="c4"><img src="{{ cover_photos[3] }}" alt=""></figure>
  </div>
  <div class="accent"></div>
  <div class="props">
    <div><div class="k">Canada</div><div class="v">Sales, installation &amp; service</div></div>
    <div><div class="k">1-year</div><div class="v">Warranty · CSA-approved panel</div></div>
    <div><div class="k">10% down</div><div class="v">0% down financing available</div></div>
    <div><div class="k">Parts</div><div class="v">&amp; technical support in Canada</div></div>
  </div>
  <div class="company">
    <img src="{{ novotech_logo }}" alt="NovoTech Machine Tools Inc.">
    <div class="txt"><b>NovoTech Machine Tools Inc.</b>{{ company_line | replace("NovoTech Machine Tools Inc. · ", "") }}</div>
    <div class="pn">01</div>
  </div>
</section>

{# ------------------------------------------------------------ 2. range / contents #}
<section class="page range" id="p-range">
  {{ header("Model range") }}
  <div class="content">
    <div class="eyebrow">{{ n_models }} models · {{ n_series }} series · pages {{ first_product_page }}–{{ last_product_page }}</div>
    <h1>The NovoTech value line band saw range</h1>
    <div class="intro">
      <p>The value line is NovoTech Machine Tools' own range: metal cutting band saws from the 10-inch full-hydraulic
        BS-315GF to CNC automatic and gantry-type double column machines, every one delivered with a CSA-approved
        electrical panel, a 1-year warranty, and parts and technical support from our Mississauga, Ontario, Canada shop.
        Capacities below are for straight (0°) cuts; the series pages give miter capacities, blade data, motors,
        weights and dimensions in imperial units with metric in brackets.</p>
      <div class="toc">
        <h3>In this catalogue</h3>
        {% for c in contents %}<div><span>{{ c.label }}</span><span>{{ c.page }}</span></div>
        {% endfor %}
      </div>
    </div>
    <table class="range-t">
      <colgroup><col class="c-model"><col class="c-type"><col class="c-round"><col class="c-rect"><col class="c-motor"><col class="c-page"></colgroup>
      <thead>
        <tr><th>Model</th><th>Type</th><th>Round capacity at 0°</th><th>Rectangular at 0°</th><th>Main motor</th><th class="pg">Page</th></tr>
      </thead>
      <tbody>
        {% for r in range_rows %}
        {% if r.group %}
        <tr class="grp"><td colspan="5">{{ r.label }}</td><td class="pg">pages {{ r.pages }}</td></tr>
        {% else %}
        <tr><td class="model">{{ r.model }}</td><td>{{ r.type }}</td><td>{{ r.round }}</td><td>{{ r.rect }}</td><td>{{ r.motor }}</td><td class="pg">{{ r.page }}</td></tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
    <p class="note">{{ voltage_line }} All capacities are maximum workpiece sizes at a 0° (straight) cut.</p>
  </div>
  {{ footer(2) }}
</section>

{# ------------------------------------------------------------ 3./4. product pages #}
{% for p in pages %}
<section class="page product m{{ p.n_models }}{% if p.thumbs %} t{{ p.thumbs | length }}{% endif %}" id="{{ p.id }}">
  {{ header(p.group_label) }}
  {% if p.section %}
  <div class="section-strip">
    <span class="num cond">{{ p.section.num }}</span>
    <span class="name cond">{{ p.section.label }}</span>
    <span class="desc">{{ p.section.desc }}</span>
  </div>
  {% endif %}
  <div class="content">
    <div class="eyebrow">{{ p.models_label }}</div>
    <h1>{{ p.name }}</h1>
    <div class="cols">
      <div class="left">
        <p class="summary">{{ p.summary }}</p>
        <ul class="features">
          {% for f in p.features %}<li>{{ f }}</li>
          {% endfor %}
        </ul>
        {% if p.optional %}
        <p class="optional"><b>Optional</b>{{ p.optional | join(" · ") }}</p>
        {% endif %}
      </div>
      <div class="right">
        <figure class="main"><img src="{{ p.main.src }}" alt="{{ p.main.alt }}"></figure>
        {% if p.thumbs %}
        <div class="thumbs">
          {% for t in p.thumbs %}
          <figure class="thumb"><img src="{{ t.src }}" alt="{{ t.cap }}"><figcaption>{{ t.cap }}</figcaption></figure>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    <table class="spec">
      <colgroup><col class="lab">{% for m in p.table.models %}<col>{% endfor %}</colgroup>
      <thead>
        <tr><th class="lab">Model</th>{% for m in p.table.models %}<th>{{ m }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for r in p.table.rows %}
        {% if r.group %}
        <tr class="grp"><td class="lab" colspan="{{ r.span + 1 }}">{{ r.label }}</td></tr>
        {% else %}
        <tr><td class="lab">{{ r.label }}</td>{% for c in r.cells %}<td{% if r.span > 1 %} colspan="{{ r.span }}"{% endif %}><span class="imp">{{ c[0] }}</span>{% if c[1] %}<span class="met">{{ c[1] }}</span>{% endif %}</td>{% endfor %}</tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
    <p class="note">{{ voltage_line }}{% for n in p.notes %} {{ n }}{% endfor %}</p>
  </div>
  {{ footer(p.n) }}
</section>
{% endfor %}

{# ------------------------------------------------------------ 5. services / contact #}
<section class="page services" id="p-services">
  {{ header("NovoTech Machine Tools") }}
  <div class="content">
    <div class="eyebrow">Sold, installed and supported in Canada</div>
    <h1>Included with every NovoTech machine</h1>
    <p class="lead">Every value-line band saw in this catalogue is sold by NovoTech Machine Tools Inc. and backed from our
      Mississauga, Ontario, Canada location — the same terms as every other machine we sell:</p>
    <ul class="svc">
      {% for it in included_items %}<li>{{ it }}</li>
      {% endfor %}
    </ul>
    <p class="volt"><b>{{ voltage_line }}</b></p>
    <div class="contact">
      <img src="{{ novotech_logo }}" alt="NovoTech Machine Tools Inc.">
      <div class="addr">
        <b>NovoTech Machine Tools Inc.</b>
        1365 Mid-Way Blvd, Unit 26<br>
        Mississauga, ON L5T 2J5, Canada<br>
        <div class="url">NovoTechMachineTools.com</div>
        info@NovoTechMachineTools.com · +1 647 526 5510
        <p class="how">Ask us for a quote on any model in this catalogue, for current stock in Mississauga, ON, Canada, or for the
          machine that fits your cutting range — we will size it against your typical stock and quote delivery,
          installation and training.</p>
      </div>
    </div>
    <div class="brandnote">
      <img src="{{ novofab_logo }}" alt="NovoTech Machine Tools">
      <p>The NovoTech value line — metal cutting band saws selected,
        sold, installed and supported in Canada by NovoTech. Value-line machines carry a CSA-approved electrical panel
        and are backed by the same warranty, parts and service as the rest of the NovoTech range.</p>
    </div>
    <p class="fine">Catalogue 2026 · Specifications subject to change without notice. Capacities are maximum
      workpiece sizes; photos may show optional equipment.</p>
  </div>
  {{ footer(last_page) }}
</section>

</body>
</html>
