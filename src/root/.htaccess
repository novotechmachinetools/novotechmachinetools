# NovoTech Machine Tools — Apache configuration (HostPapa)

# ---- Canonical host: force https and drop www -------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---- Clean URLs: /band-saw serves band-saw.html, and /band-saw.html redirects to /band-saw ----
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---- Old URLs that changed (add one line per moved page) ---------------------
# RedirectMatch 301 ^/old-page(\.html)?$ /new-page
RedirectMatch 301 ^/bekamak-pivot-band-saw(\.html)?$ /band-saw
RedirectMatch 301 ^/plate-roller-bender(\.html)?$ /plate-rollers
RedirectMatch 301 ^/plate-roller-buying-guide(\.html)?$ /plate-rollers#buying-guide
RedirectMatch 301 ^/bead-roller-hvac-forming-pittsburgh-lock-former(\.html)?$ /bead-rollers
RedirectMatch 301 ^/circular-cutting-shear-tank-dish-head-flanging(\.html)?$ /circle-cutters-and-seamers
RedirectMatch 301 ^/pipe-bender(\.html)?$ /pipe-benders
RedirectMatch 301 ^/pipe-notcher(\.html)?$ /tube-notchers-and-end-formers
# band saw sub-pages live at /manual-band-saws, /semi-automatic-band-saws, /automatic-band-saws and
# /double-column-band-saws (Bekamak) and /affordable-semi-automatic-band-saws, /automatic-feed-band-saws,
# /twin-column-band-saws (value line) — brand-free URLs, Oct 2026.  Earlier brand slugs redirect:
RedirectMatch 301 ^/bekamak-(manual|semi-automatic|automatic|double-column)-band-saws(\.html)?$ /$1-band-saws
RedirectMatch 301 ^/(novofab|novotech)-manual-band-saws(\.html)?$ /manual-band-saws
RedirectMatch 301 ^/(novofab|novotech)-semi-automatic-band-saws(\.html)?$ /affordable-semi-automatic-band-saws
RedirectMatch 301 ^/(novofab|novotech)-automatic-band-saws(\.html)?$ /automatic-feed-band-saws
RedirectMatch 301 ^/(novofab|novotech)-double-column-band-saws(\.html)?$ /twin-column-band-saws
RedirectMatch 301 ^/novofab-(.*)$ /novotech-$1

