# NovoTech Machine Tools — Apache configuration (HostPapa)

# ---- Canonical host: force https and drop www -------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---- Server-side settings and keys are never served ------------------------------
<FilesMatch "^(\.user\.ini|form-config\.php|ai-config\.php|.*\.sample\.php|\.cpanel\.yml|\.deploy-hostpapa\.sh)$">
  Require all denied
</FilesMatch>

# ---- Clean URLs: /band-saw serves band-saw.html, and /band-saw.html redirects to /band-saw ----
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---- Old URLs that changed (add one line per moved page) ---------------------
# RedirectMatch 301 ^/old-page(\.html)?$ /new-page
RedirectMatch 301 ^/bekamak-pivot-band-saw(\.html)?$ /band-saw
RedirectMatch 301 ^/sheet-metal-deburring-machines(\.html)?$ /sheet-metal-plate-deburring-edge-rounding-finishing-grinding
RedirectMatch 301 ^/edge-rounding-deslagging-machines(\.html)?$ /sheet-metal-plate-deburring-edge-rounding-finishing-grinding
RedirectMatch 301 ^/brush-deburring-machines(\.html)?$ /sheet-metal-plate-deburring-edge-rounding-finishing-grinding
RedirectMatch 301 ^/plate-roller-bender(\.html)?$ /plate-rollers
RedirectMatch 301 ^/plate-roller-buying-guide(\.html)?$ /plate-rollers#buying-guide
RedirectMatch 301 ^/ironworker-buying-guide(\.html)?$ /ironworker-machines#buying-guide
RedirectMatch 301 ^/bead-roller-hvac-forming-pittsburgh-lock-former(\.html)?$ /bead-rollers
RedirectMatch 301 ^/circular-cutting-shear-tank-dish-head-flanging(\.html)?$ /circle-cutters-and-seamers
RedirectMatch 301 ^/pipe-bender(\.html)?$ /pipe-benders
RedirectMatch 301 ^/tube-notchers-and-end-formers(\.html)?$ /pipe-notcher
RedirectMatch 301 ^/iron-worker-punch(\.html)?$ /ironworker-machines
RedirectMatch 301 ^/pipe-profile-roll-bender(\.html)?$ /angle-rolls
RedirectMatch 301 ^/pipe-polishing-deburring-grinding-brushing(\.html)?$ /pipe-sanding-polishing-machines
# band saw sub-pages live at /manual-band-saws, /semi-automatic-band-saws, /automatic-band-saws and
# /double-column-band-saws (Bekamak) and /affordable-semi-automatic-band-saws, /automatic-feed-band-saws,
# /twin-column-band-saws (value line) — brand-free URLs, Oct 2026.  Earlier brand slugs redirect:
RedirectMatch 301 ^/bekamak-(manual|semi-automatic|automatic|double-column)-band-saws(\.html)?$ /$1-band-saws
RedirectMatch 301 ^/(novofab|novotech)-manual-band-saws(\.html)?$ /manual-band-saws
RedirectMatch 301 ^/(novofab|novotech)-semi-automatic-band-saws(\.html)?$ /affordable-semi-automatic-band-saws
RedirectMatch 301 ^/(novofab|novotech)-automatic-band-saws(\.html)?$ /automatic-feed-band-saws
RedirectMatch 301 ^/(novofab|novotech)-double-column-band-saws(\.html)?$ /twin-column-band-saws
RedirectMatch 301 ^/novofab-(.*)$ /novotech-$1
# the old automatic cold saw page (Bekamak BMDO) now lives on the cold saw page, below the İşitan circular saws
# press brakes are split by kind of machine, not by supplier (Oct 2026): the supplier pages redirect to the type pages
RedirectMatch 301 ^/dener-cnc-press-brakes(\.html)?$ /hydraulic-press-brake
RedirectMatch 301 ^/novotech-cnc-press-brakes(\.html)?$ /hydraulic-press-brake
# shears are split by kind of machine, not by supplier (Oct 2026)
RedirectMatch 301 ^/dener-shears(\.html)?$ /hydraulic-shearing-machine
RedirectMatch 301 ^/novotech-mechanical-shears(\.html)?$ /mechanical-guillotine-shear
# two kinds of shear only (the owner, Nov 7 2026): the sheet metal shears page merged into the hydraulic and mechanical pages
RedirectMatch 301 ^/sheet-metal-shears(\.html)?$ /mechanical-guillotine-shear
# pipe benders by kind of machine (the owner, Nov 7 2026): the CSM line page and the value-line page merged into the three kind pages
RedirectMatch 301 ^/csm-tube-benders(\.html)?$ /cnc-tube-benders
RedirectMatch 301 ^/tube-bender(\.html)?$ /rotary-draw-tube-benders
# CNC plasma tables are not sold any more (the owner, Nov 7 2026)
RedirectMatch 301 ^/cnc-plasma-table(\.html)?$ /laser-cutting-machine
# lasers are split by kind of machine, not by supplier (Oct 2026)
RedirectMatch 301 ^/dener-fiber-lasers(\.html)?$ /fiber-laser-cutting-machine
RedirectMatch 301 ^/novotech-fiber-lasers(\.html)?$ /fiber-laser-cutting-machine
RedirectMatch 301 ^/senfeng-fiber-lasers(\.html)?$ /fiber-laser-cutting-machine
# the laser kind pages renamed (the owner, Oct 31 2026): no open-type machines, no "enclosed" in the names, 3D and coil-fed apart
RedirectMatch 301 ^/enclosed-fiber-laser(\.html)?$ /fiber-laser-cutting-machine
RedirectMatch 301 ^/open-type-fiber-laser(\.html)?$ /laser-cutting-machine
RedirectMatch 301 ^/3d-laser-and-coil-fed-line(\.html)?$ /3d-laser-cutting-machine
RedirectMatch 301 ^/dener-tube-lasers(\.html)?$ /tube-laser-cutting-machine
RedirectMatch 301 ^/novotech-tube-lasers(\.html)?$ /tube-laser-cutting-machine
RedirectMatch 301 ^/senfeng-tube-lasers(\.html)?$ /tube-laser-cutting-machine
# the tube lasers are one page (the owner, Nov 1 2026)
RedirectMatch 301 ^/tube-laser-cutter(\.html)?$ /tube-laser-cutting-machine
RedirectMatch 301 ^/heavy-duty-tube-laser(\.html)?$ /tube-laser-cutting-machine
RedirectMatch 301 ^/slip-rolls(\.html)?$ /plate-rollers
RedirectMatch 301 ^/cold-saw-carbide-saw-cutting(\.html)?$ /automatic-cold-saws#bekamak-circular-group
# Old pages with backlinks (Ahrefs, Nov 2026) whose products are no longer sold: the nearest page keeps the link value
RedirectMatch 301 ^/magnetic-drill(\.html)?$ /drill-press
RedirectMatch 301 ^/lifting-magnet(\.html)?$ /products
RedirectMatch 301 ^/annular-cutter(s)?(\.html)?$ /drill-press

